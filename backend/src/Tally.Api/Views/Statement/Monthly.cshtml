@model StatementViewModel
@{
    Layout = null;
    var us = CultureInfo.GetCultureInfo("en-US");
    string Money(decimal v) => v.ToString("C", us);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tally statement – @Model.MonthName</title>
    <style>
        body { font-family: "Segoe UI", system-ui, sans-serif; color: #18241F; margin: 0; background: #F3F6F2; }
        .sheet { max-width: 760px; margin: 32px auto; background: #fff; padding: 40px 48px; border: 1px solid #D5DED8; }
        header { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid #2F6B4F; padding-bottom: 12px; }
        .brand { font-size: 22px; font-weight: 700; color: #2F6B4F; }
        h1 { font-size: 18px; margin: 20px 0 4px; }
        .muted { color: #5B6B7A; }
        .totals { display: flex; gap: 48px; margin: 20px 0 28px; }
        .totals strong { display: block; font-size: 22px; font-variant-numeric: tabular-nums; }
        h2 { font-size: 14px; margin: 28px 0 8px; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { text-align: left; background: #E8EFEA; padding: 6px 8px; }
        td { padding: 6px 8px; border-bottom: 1px solid #EDF1EE; }
        .num { text-align: right; font-variant-numeric: tabular-nums; }
        .over { color: #C2412D; font-weight: 600; }
        .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; }
        .print { position: fixed; right: 20px; top: 20px; padding: 8px 16px; background: #2F6B4F; color: #fff; border: 0; border-radius: 6px; font: inherit; cursor: pointer; }
        @@media print {
            body { background: #fff; }
            .sheet { margin: 0; border: 0; padding: 0; }
            .print { display: none; }
        }
    </style>
</head>
<body>
<button class="print" onclick="window.print()">Print</button>
<div class="sheet">
    <header>
        <span class="brand">Tally</span>
        <span class="muted">Monthly statement</span>
    </header>

    <h1>@Model.MonthName</h1>
    <div class="muted">Prepared for @Model.DisplayName</div>

    <div class="totals">
        <div><span class="muted">Spent</span><strong>@Money(Model.Total)</strong></div>
        <div><span class="muted">Budgeted</span><strong>@Money(Model.TotalBudget)</strong></div>
        <div><span class="muted">Transactions</span><strong>@Model.Expenses.Count</strong></div>
    </div>

    @if (Model.Budgets.Any())
    {
        <h2>Budget vs. actual</h2>
        <table>
            <thead><tr><th>Category</th><th class="num">Budget</th><th class="num">Spent</th><th class="num">Left</th></tr></thead>
            <tbody>
            @foreach (var b in Model.Budgets.OrderByDescending(b => b.Spent))
            {
                <tr>
                    <td><span class="dot" style="background:@b.CategoryColor"></span>@b.CategoryName</td>
                    <td class="num">@Money(b.Limit)</td>
                    <td class="num">@Money(b.Spent)</td>
                    <td class="num @(b.Remaining < 0 ? "over" : "")">@Money(b.Remaining)</td>
                </tr>
            }
            </tbody>
        </table>
    }

    <h2>Transactions</h2>
    @if (Model.Expenses.Count == 0)
    {
        <p class="muted">No expenses were recorded this month.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Date</th><th>Description</th><th>Category</th><th class="num">Amount</th></tr></thead>
            <tbody>
            @foreach (var e in Model.Expenses)
            {
                <tr>
                    <td>@e.Date.ToString("MMM d", us)</td>
                    <td>@e.Description</td>
                    <td>@e.CategoryName</td>
                    <td class="num">@Money(e.Amount)</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
</body>
</html>
